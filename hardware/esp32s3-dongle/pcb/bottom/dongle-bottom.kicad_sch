	)
	(text "Modes by STB_N / EN: normal H/H, listen-only H/L, standby L/L, go-to-sleep L/H."
		(exclude_from_sim no)
		(at 20.32 100.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f8207342-7da1-533a-abc1-ca8451a527d6")
	)
	(text "Both have internal pull-downs, so it comes up in standby: it cannot drive the bus until firmware asks."
		(exclude_from_sim no)
		(at 20.32 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d270f044-b181-5409-b09d-9202548de49a")
	)
	(text "In sleep, INH floats and R4 turns the buck off. CAN activity or a change on WAKE wakes it."
		(exclude_from_sim no)
		(at 20.32 105.41 0)
		(effects
			(font

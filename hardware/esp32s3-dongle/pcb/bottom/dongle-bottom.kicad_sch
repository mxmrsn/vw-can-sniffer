	(text "U3 watches VBAT: above 13.4 V (rising; 13.2 V falling) OUTA releases, Q1 pulls WAKE_BTN low,"
		(exclude_from_sim no)
		(at 20.32 247.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1cf6e6ae-9c84-5a93-9e95-f7f4608cc9ed")
	)
	(text "and that change on WAKE wakes the transceiver. The top-board button pulls the same node low."
		(exclude_from_sim no)
		(at 20.32 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "83360288-a58d-5c7e-b6a4-b6f9c28e32ab")
	)
	(text "Parked, nothing pulls WAKE_BTN low and R9 holds it high: about 15 uA in all."

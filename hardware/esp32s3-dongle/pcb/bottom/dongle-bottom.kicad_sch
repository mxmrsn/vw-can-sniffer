	)
	(text "Modes by STB_N / EN: normal H/H, listen-only H/L, standby L/L, go-to-sleep L/H."
		(exclude_from_sim no)
		(at 20.32 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b1ba6b87-96f4-53d1-9a16-9cc52ac18ffe")
	)
	(text "Both have internal pull-downs, so it comes up in standby: it cannot drive the bus until firmware asks."
		(exclude_from_sim no)
		(at 20.32 92.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7d548aca-2714-504a-b8c1-4effe3b694d1")
	)
	(text "In sleep, INH floats and R4 turns the buck off. CAN activity or a change on WAKE wakes it."
		(exclude_from_sim no)
		(at 20.32 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)

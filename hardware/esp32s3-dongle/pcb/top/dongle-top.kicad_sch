		(at 20.32 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7062ec04-f48b-516c-b865-c7836798fb9a")
	)
	(text "and, through D3, reads as MODE_IN on a running one. D3 keeps the 12 V-level line off the GPIO."
		(exclude_from_sim no)
		(at 20.32 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e598396f-9992-5566-812d-9e25e9b30225")
	)
	(text "Four addressable LEDs on one pin, buffered to the LED supply as on v0.3.0."
